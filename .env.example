# Required for every binary: development, test, or production.
COMMIT_ENVIRONMENT=development
# `commit-api` only: listener and browser-facing HTTP policy.
COMMIT_BIND_ADDR=127.0.0.1:8080
# Must use exactly /api/v1/ with no prefix, query, or fragment. Production
# requires HTTPS; a missing trailing slash is normalized.
COMMIT_PUBLIC_BASE_URL=http://127.0.0.1:8080/api/v1/
# Empty denies cross-origin browser access; comma-separate exact origins.
COMMIT_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Production runtime and migrator URLs require exactly one
# sslmode=verify-full (or ssl-mode=verify-full) parameter.
COMMIT_DATABASE_URL=postgres://commit:commit@127.0.0.1:5432/silicon_commit
# The Compose `commit` role owns the local database. Use a separately
# privileged migrator role in deployed environments.
COMMIT_MIGRATOR_DATABASE_URL=postgres://commit:commit@127.0.0.1:5432/silicon_commit
# `commit-migrate` refuses credentials or existing objects owned by any other role.
COMMIT_SCHEMA_OWNER=commit

# `commit-api` only: IAM authentication and directory integration.
COMMIT_AUTH_MODE=iam
COMMIT_IAM_BASE_URL=https://iam.teamofsilicons.com/api/v1/
COMMIT_IAM_APP_ID=silicon-commit
COMMIT_IAM_APP_SECRET=replace-me
COMMIT_IAM_AUDIENCE=silicon-commit



# Runtime limits may be lowered but cannot exceed the public v1 contract caps.
COMMIT_MAX_TITLE_CHARS=500
COMMIT_MAX_PROJECT_NAME_CHARS=200
COMMIT_MAX_DESCRIPTION_CHARS=20000
COMMIT_MAX_NOTE_CHARS=20000
COMMIT_MAX_ATTACHMENTS_PER_TODO=20
COMMIT_MAX_PROJECT_PARTICIPANTS=100
COMMIT_IDEMPOTENCY_TTL_SECONDS=86400

# The lease must outlive the provider request timeout.
COMMIT_PROVIDER_TIMEOUT_SECONDS=5
COMMIT_WORKER_LEASE_SECONDS=30
COMMIT_WORKER_MAX_RETRY_SECONDS=3600
COMMIT_WORKER_BATCH_SIZE=100
# Webhook calls are independently bounded even when a large database batch is claimed.
COMMIT_WORKER_DELIVERY_CONCURRENCY=16
# API and worker stop new work, then drain in-flight jobs for this deadline.
COMMIT_SHUTDOWN_TIMEOUT_SECONDS=30
# Each maintenance statement affects at most this many rows per pass.
COMMIT_MAINTENANCE_BATCH_SIZE=1000
# Deadlines are frozen on each row when its retention clock starts. These
# defaults are 45-day content purge, 7-year audit metadata, 30-day delivered
# events, and 90-day dead letters. Delivered/dead-letter windows cannot be
# lower than 30/90 days. Idempotency cannot be below 24 hours or exceed todo
# content retention.
COMMIT_TODO_TOMBSTONE_RETENTION_SECONDS=3888000
COMMIT_AUDIT_RETENTION_SECONDS=220752000
COMMIT_DELIVERED_OUTBOX_RETENTION_SECONDS=2592000
COMMIT_DEAD_LETTER_OUTBOX_RETENTION_SECONDS=7776000

COMMIT_LOG=silicon_commit=info,tower_http=info
# Incoming IAM webhook verification. Keep the secret in the deployment secret store.
COMMIT_WEBHOOK_SIGNING_SECRET=replace-me
COMMIT_WEBHOOK_KEY_VERSION=1
