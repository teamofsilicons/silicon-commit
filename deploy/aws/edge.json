{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Commit standalone EC2 API and worker with private PostgreSQL; no load balancer",
  "Parameters": {
    "SecretArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "HostSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Commit standalone HTTPS host",
        "VpcId": "vpc-04b23a487cfe0bd8e",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "CommitRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": "arn:aws:ecr:us-east-1:234951665042:repository/silicon-commit"
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "SecretArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": "ami-07987a01dcdb011ef",
        "InstanceType": "t4g.small",
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Encrypted": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "silicon-commit-production"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -eu\ndnf install -y docker amazon-ssm-agent\nsystemctl enable --now docker amazon-ssm-agent\nmkdir -p /opt/commit\nchmod 700 /opt/commit\n"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": "subnet-07945746462c26b2d",
            "GroupSet": [
              {
                "Ref": "HostSG"
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Host"
      }
    },
    "PublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Host",
          "PublicIp"
        ]
      }
    }
  }
}
